{
  "name": "weather-activity-recommendation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript Node.js GraphQL backend for weather-based activity recommendations.",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx ./node_modules/mocha/bin/mocha.js \"tests/**/*.test.ts\"",
    "test:unit": "tsx ./node_modules/mocha/bin/mocha.js \"tests/unit/**/*.test.ts\"",
    "test:integration": "tsx ./node_modules/mocha/bin/mocha.js \"tests/integration/**/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@apollo/server": "5.4.0",
    "@prisma/client": "5.22.0",
    "graphql": "16.11.0",
    "ioredis": "5.4.1",
    "pino": "9.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@types/chai": "5.0.1",
    "@types/mocha": "10.0.9",
    "@types/node": "22.9.0",
    "@types/sinon": "17.0.3",
    "chai": "5.1.2",
    "eslint": "9.13.0",
    "mocha": "10.7.3",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "sinon": "19.0.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0"
  },
  "engines": {
    "node": ">=22"
  }
}
